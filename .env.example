# AI features (summaries + article Q&A) — any OpenAI-compatible endpoint works:
# OpenAI itself, vLLM, LiteLLM, Ollama (http://localhost:11434/v1), etc.
# Copy to .env and fill in. Without these, NewsRead runs fine as a plain reader.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Set to true when OPENAI_MODEL accepts image input: articles whose page has
# no extractable text (comics, charts) then get summarized from a rendered
# screenshot instead of failing.
OPENAI_MODEL_VISION=false

# Embedding model for semantic article search, served by the same endpoint.
# Optional: without it (or without the pgvector extension in Postgres),
# search falls back to keyword matching.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI illustrations for articles that arrive without an image. Optional:
# without these, articles just keep their scraped image (or none). Any
# OpenAI-compatible images endpoint works; an OpenRouter base URL is served
# through OpenRouter's dedicated image API (https://openrouter.ai/api/v1/images),
# which also accepts generation parameters like aspect_ratio.
IMAGE_GENERATION_BASE_URL=https://openrouter.ai/api/v1
IMAGE_GENERATION_MODEL=google/gemini-2.5-flash-image
IMAGE_GENERATION_API_KEY=sk-or-...
# Model-specific parameters merged into every generation request, as one JSON
# object. 16:9 fits the app's card/hero frames best (they crop to 2:1 and 16:9).
IMAGE_GENERATION_EXTRA_PARAMS={"aspect_ratio":"16:9"}

# Translating AI summaries into the reader's language (the Translate action on
# a summary). Optional: without a model here, translation runs on OPENAI_MODEL
# above, and with neither the action is hidden. Translations are cached per
# article + language and shared by all readers, so a cheap or free model does
# the job — and the model ID is a setting because free-tier availability and
# provider routing change. Any OpenAI-compatible chat endpoint works; the base
# URL defaults to OpenRouter.
TRANSLATION_BASE_URL=https://openrouter.ai/api/v1
TRANSLATION_MODEL=nvidia/nemotron-3-super-120b-a12b:free
TRANSLATION_API_KEY=sk-or-...

# YouTube channels (Catalog -> Smart feeds -> YouTube). Optional: handles and
# channel URLs resolve by reading the channel page, and captions never need a
# key. Set one to look a channel up by its display name (and to resolve handles
# through the Data API): https://console.cloud.google.com -> YouTube Data API v3.
#YOUTUBE_API_KEY=

# Web search + page extraction for the Q&A agent. Optional: without either,
# the assistant answers from the article text only. Two providers:
#
# 1) Tavily — hosted search + extraction (https://tavily.com, free tier).
TAVILY_API_KEY=tvly-...
#
# 2) SearXNG — self-hosted metasearch, no API key; page extraction runs
#    locally. Takes precedence over Tavily when both are set.
#    Start one with: docker compose --profile search up -d searxng
#    (A backend running inside docker compose automatically uses
#    http://searxng:8080 instead; set NEWSREAD_SEARXNG_BASE_URL to force
#    an external instance.)
#SEARXNG_BASE_URL=http://localhost:8080

# --- Deployment mode ---
# Where this instance runs: self_hosted (default) | staging | prod.
# The mode picks defaults for the feature flags below; each flag can be
# overridden individually.
#   self_hosted  single-user: signups close once the first (owner) account
#                exists, and Slack/Teams integrations are hidden.
#   staging/prod multi-user: signups open, messaging integrations available
#                (still require the credentials below). Refuses to boot with the
#                dev JWT secret — set NEWSREAD_JWT_SECRET to a real value.
#NEWSREAD_DEPLOYMENT=self_hosted
#
# Per-flag overrides (win over the mode default):
#NEWSREAD_ALLOW_SIGNUP=true
#NEWSREAD_MESSAGING_ENABLED=true
# Browser history is privacy-sensitive. Defaults follow the deployment mode
# (on for prod/staging, off for self_hosted); set explicitly to override.
#NEWSREAD_BROWSER_HISTORY_ENABLED=true
# Whether the first account registered on an empty instance becomes the
# instance owner. Defaults to true for self_hosted, false for staging/prod
# (public signup must never mint an owner — promote one with
# `scripts/set_role.py` instead).
#NEWSREAD_FIRST_ACCOUNT_OWNER=true
# Tier for accounts with no manual assignment: 'unlimited' for self_hosted,
# 'free' for staging/prod. Any tiers.key value works; tiers themselves are
# rows in the tiers table (defaults: free 100/mo, paid 1000/mo, unlimited).
#NEWSREAD_DEFAULT_TIER=free
# Whether users may save their own LLM API keys ("bring your own key").
# Defaults to true for self_hosted, false for staging/prod so hosted usage
# all runs on the metered server-wide key. Turning it off blocks saving new
# keys; already-stored keys keep working until their owner removes them.
#NEWSREAD_BYO_LLM_KEYS_ENABLED=true
#
# V2 encrypted content storage rolls out separately from the existing metadata
# history feature. Leave false until the content-storage migration is deployed.
#NEWSREAD_BROWSER_HISTORY_CONTENT_ENABLED=false
# Final cutover after the dual-read search audit and migration 0011. Advertises
# capability revision 3 and treats old-extension inline bodies as metadata only.
#NEWSREAD_BROWSER_HISTORY_FINALIZE_ENABLED=false
# Temporary revision-2 compatibility window. Disable after old zip-distributed
# extensions have had time to upgrade (finalize=true always disables it).
#NEWSREAD_BROWSER_HISTORY_LEGACY_INLINE_ENABLED=true
#
# S3-compatible private object storage. Docker Compose supplies internal SeaweedFS
# defaults; set these when the backend runs elsewhere or uses another provider.
# Two buckets on the same endpoint: _BUCKET holds encrypted browser-history
# objects, _MEDIA_BUCKET the AI-generated article images (created on demand at
# startup). Image generation needs the endpoint configured — the images are not
# stored in Postgres.
#NEWSREAD_OBJECT_STORE_ENDPOINT=https://s3.example.com
#NEWSREAD_OBJECT_STORE_ACCESS_KEY=
#NEWSREAD_OBJECT_STORE_SECRET_KEY=
#NEWSREAD_OBJECT_STORE_BUCKET=newsread-history
#NEWSREAD_OBJECT_STORE_MEDIA_BUCKET=newsread-media
#NEWSREAD_OBJECT_STORE_REGION=us-east-1
#NEWSREAD_OBJECT_STORE_SECURE=true
#NEWSREAD_HISTORY_OBJECT_MAX_BYTES=1048576
#NEWSREAD_HISTORY_OBJECT_COMPRESSED_MAX_BYTES=524288
#NEWSREAD_HISTORY_IMAGE_MAX_BYTES=204800
#NEWSREAD_HISTORY_USER_STORAGE_MAX_BYTES=536870912
#NEWSREAD_HISTORY_EMBEDDING_DAILY_LIMIT=1000
#NEWSREAD_HISTORY_OBJECT_GC_GRACE_HOURS=24
#NEWSREAD_HISTORY_OBJECT_GC_SCAN_LIMIT=10000
#NEWSREAD_HISTORY_OBJECT_DELETE_BATCH=200
#NEWSREAD_HISTORY_EMBEDDING_BACKLOG_ALERT_HOURS=6
#NEWSREAD_HISTORY_DELETION_BACKLOG_ALERT_HOURS=1
#NEWSREAD_HISTORY_STORAGE_ALERT_RATIO=0.9
#
# AES-256 master key wrapping per-user history data keys. Generate with:
#   python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#NEWSREAD_HISTORY_ENCRYPTION_MASTER_KEY=
#NEWSREAD_HISTORY_ENCRYPTION_WRAPPING_KEY_VERSION=1
# During rotation, keep old versioned keys as JSON until every data-key row is
# rewrapped. Never include the current key here.
#NEWSREAD_HISTORY_ENCRYPTION_PREVIOUS_MASTER_KEYS={"1":"old-base64-key"}

# --- Public deployment ---
# API base URL baked into the web frontend's browser bundle at BUILD time
# (docker compose passes it as a build arg; changing it requires
# `docker compose up -d --build frontend`). Leave unset for local use
# (defaults to http://localhost:8000). When serving behind a public domain,
# set it to that domain and have your reverse proxy route /api to the
# backend (:8000) and everything else to the frontend (:3000) — API calls
# are then same-origin, so no extra CORS setup is needed.
#NEXT_PUBLIC_API_URL=https://news.example.com

# Extra browser origins allowed to call the backend, comma-separated
# (e.g. LAN access to the dev servers from other devices).
#NEWSREAD_CORS_ORIGINS=http://localhost:3000,http://192.168.1.20:3000

# --- Messaging integrations (share to Slack / Teams as the user) ---
# All optional: without them the platform just shows as unavailable in
# Settings -> Connections. Setup guide: docs/messaging-setup.md

# Slack app credentials (api.slack.com/apps -> Basic Information).
NEWSREAD_SLACK_CLIENT_ID=
NEWSREAD_SLACK_CLIENT_SECRET=
# Only needed for future inbound features (e.g. syncing Slack replies back
# as comments); harmless to set now.
NEWSREAD_SLACK_SIGNING_SECRET=

# Microsoft Entra app registration (portal.azure.com -> App registrations).
NEWSREAD_TEAMS_CLIENT_ID=
NEWSREAD_TEAMS_CLIENT_SECRET=
# "organizations" works for any work/school tenant; set a tenant id to pin
# the app to a single tenant (single-tenant registration).
NEWSREAD_TEAMS_TENANT=organizations

# Public base URL for OAuth callbacks. Slack requires HTTPS, so in local dev
# point this at a tunnel to the backend, e.g. ngrok:
#   ngrok http --domain=<your-static-domain> 8000
#NEWSREAD_OAUTH_REDIRECT_BASE=https://<your-static-domain>.ngrok-free.app
NEWSREAD_OAUTH_REDIRECT_BASE=http://localhost:8000

# Browser lands here after connecting (the settings page host).
NEWSREAD_FRONTEND_BASE_URL=http://localhost:3000

# Encrypts per-user Slack/Teams tokens at rest in Postgres. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEWSREAD_TOKEN_ENCRYPTION_KEY=
